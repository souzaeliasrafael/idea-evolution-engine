APP_NAME=Idea Evolution Engine
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./iee.db
LLM_PROVIDER=mock
LLM_MODEL=mock-llm-v1
LLM_INPUT_COST_PER_MILLION=0
LLM_CACHED_INPUT_COST_PER_MILLION=
LLM_OUTPUT_COST_PER_MILLION=0
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=4096
LLM_RETRY_MAX_OUTPUT_TOKENS=16384
BUILDER_MAX_OUTPUT_TOKENS=8192
ADAPTIVE_AGENT_DEPTH_ENABLED=true
ADAPTIVE_DEPTH_SCORE_THRESHOLD=75
ADAPTIVE_DEPTH_CONFIDENCE_THRESHOLD=0.70
ALLOW_UNPRICED_CLOUD_MODELS=false
STRUCTURER_PROVIDER=mock
STRUCTURER_MODEL=mock-llm-v1
STRUCTURER_INPUT_COST_PER_MILLION=
STRUCTURER_OUTPUT_COST_PER_MILLION=
BUILDER_PROVIDER=mock
BUILDER_MODEL=mock-llm-v1
BUILDER_INPUT_COST_PER_MILLION=
BUILDER_CACHED_INPUT_COST_PER_MILLION=
BUILDER_OUTPUT_COST_PER_MILLION=
CRITIC_PROVIDER=mock
CRITIC_MODEL=mock-llm-v1
CRITIC_INPUT_COST_PER_MILLION=
CRITIC_OUTPUT_COST_PER_MILLION=
RESEARCHER_PROVIDER=mock
RESEARCHER_MODEL=mock-llm-v1
RESEARCHER_INPUT_COST_PER_MILLION=
RESEARCHER_OUTPUT_COST_PER_MILLION=
RESEARCH_WEB_ENABLED=true
RESEARCH_WEB_MAX_CALLS=2
RESEARCH_WEB_CONTEXT_SIZE=low
JUDGE_PROVIDER=mock
JUDGE_MODEL=mock-llm-v1
JUDGE_INPUT_COST_PER_MILLION=
JUDGE_OUTPUT_COST_PER_MILLION=
# Optional override. When omitted, Improver inherits Builder.
IMPROVER_PROVIDER=
IMPROVER_MODEL=
IMPROVER_INPUT_COST_PER_MILLION=
IMPROVER_OUTPUT_COST_PER_MILLION=
# Optional overrides. When omitted, Product/Solution Architect inherit Builder,
# Technical Critic inherits Critic, and Roadmap Planner inherits Judge.
PRODUCT_ARCHITECT_PROVIDER=
PRODUCT_ARCHITECT_MODEL=
PRODUCT_ARCHITECT_INPUT_COST_PER_MILLION=
PRODUCT_ARCHITECT_OUTPUT_COST_PER_MILLION=
SOLUTION_ARCHITECT_PROVIDER=
SOLUTION_ARCHITECT_MODEL=
SOLUTION_ARCHITECT_INPUT_COST_PER_MILLION=
SOLUTION_ARCHITECT_OUTPUT_COST_PER_MILLION=
TECHNICAL_CRITIC_PROVIDER=
TECHNICAL_CRITIC_MODEL=
TECHNICAL_CRITIC_INPUT_COST_PER_MILLION=
TECHNICAL_CRITIC_OUTPUT_COST_PER_MILLION=
ROADMAP_PLANNER_PROVIDER=
ROADMAP_PLANNER_MODEL=
ROADMAP_PLANNER_INPUT_COST_PER_MILLION=
ROADMAP_PLANNER_OUTPUT_COST_PER_MILLION=
OPENAI_API_KEY=
OPENAI_ADMIN_KEY=
# Optional comma-separated OpenAI project IDs used to filter billing reconciliation.
OPENAI_BILLING_PROJECT_IDS=
OPENAI_WEB_SEARCH_COST_PER_CALL=0.01
OPENAI_BASE_URL=https://api.openai.com/v1
# Natural Judge voice over the OpenAI Realtime API. The standard OpenAI API key
# stays on the backend; the browser receives only a short-lived client secret.
VOICE_REALTIME_ENABLED=true
VOICE_REALTIME_MODEL=gpt-realtime-2.1
VOICE_REALTIME_VOICE=marin
VOICE_REALTIME_MAX_SESSION_SECONDS=600
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
LLM_MAX_ATTEMPTS=2
MAX_ROUNDS=5
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
